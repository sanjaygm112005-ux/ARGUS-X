# ARGUS-X Full-Stack Environment Configuration
# Copy this file to .env and replace placeholder values before running in production.

# Application Database (Neon PostgreSQL recommended for production)
# Paste your Neon connection string from https://console.neon.tech:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_6WjDl8gspMdX@ep-spring-block-be5drxsl-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Separate AI Biometric Memory Paths (kept isolated from user/auth database)
AI_MEMORY_DB_PATH=logs/argus_memory.db
AI_MEMORY_INDEX_PATH=logs/argus_memory.faiss

# JWT & Cookie Security (generate a strong 32+ byte random secret for production)
JWT_SECRET_KEY=change-this-to-a-strong-64-char-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Login Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Initial Admin Bootstrap (only used when no admin user exists yet)
BOOTSTRAP_ADMIN_EMAIL=admin@argusx.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!123
